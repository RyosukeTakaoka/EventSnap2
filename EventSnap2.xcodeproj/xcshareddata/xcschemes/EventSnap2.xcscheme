         </BuildableReference>
      </BuildableProductRunnable>
      <!-- App Store提出用スクリーンショットの撮影モード。
           普段の実行では必ずオフにしておくこと。オンのままだとFixtureの
           イベントが注入されてホーム画面に到達できず、イベント作成の導線を
           一度も通れなくなる。撮影するときだけXcodeでチェックを入れる。
           （以前は "-EventSnapScreenshot" の末尾に全角スペースが混入していて
             キーが一致せず、引数を渡しても撮影モードにならなかった） -->
      <CommandLineArguments>
         <CommandLineArgument
            argument = "-EventSnapScreenshot"
            isEnabled = "NO">
         </CommandLineArgument>
         <CommandLineArgument
            argument = "1"
            isEnabled = "NO">
         </CommandLineArgument>
         <CommandLineArgument
            argument = "-EventSnapScreenshotScene"
            isEnabled = "NO">
         </CommandLineArgument>
         <CommandLineArgument
            argument = "albumGrid"
            isEnabled = "NO">
         </CommandLineArgument>
      </CommandLineArguments>
   </LaunchAction>
   <ProfileAction
