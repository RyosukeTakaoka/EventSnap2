<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Clip であることを示すフラグ (Boolean) -->
	<key>com.apple.developer.on-demand-install-capable</key>
	<true/>

	<!-- 親アプリ (メインアプリ) の Bundle Identifier -->
	<key>com.apple.developer.parent-application-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)app.takaoka.com.EventSnap2</string>
	</array>

	<!--
	  Vercel上のEventSnap WebサイトをApp Clip / Universal Linkの入口として使用。
	  Services/AppLinkConfig.swift の host と同じドメイン。
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>appclips:eventsnap-website.vercel.app</string>
		<string>applinks:eventsnap-website.vercel.app</string>
	</array>

	<!--
	  ⚠️ iCloud / CloudKit のentitlementは **App Clipには付けられない**。
	  App ClipのApp IDにはiCloud capabilityが存在しないため、書くと
	  「Provisioning profile ... doesn't match the entitlements file's value for
	  the com.apple.developer.icloud-services entitlement」で署名に失敗する。

	  一時期ここに `com.apple.developer.icloud-services` /
	  `com.apple.developer.icloud-container-identifiers` を足して、App Clipから
	  CloudKitのPublic Databaseを読み取り専用で使う実装(EventPreviewLoader)を
	  置いていたが、そもそも成立しないため撤去した。App Clipは
	  ネットワークアクセスを一切行わない案内画面だけを持つ
	  （EventSnapClipRootView参照）。
	-->
</dict>
</plist>
