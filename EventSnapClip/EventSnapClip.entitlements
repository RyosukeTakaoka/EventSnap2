<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Clip であることを示すフラグ (Boolean) -->
	<key>com.apple.developer.on-demand-install-capable</key>
	<true/>

	<!-- 親アプリ (メインアプリ) の Bundle Identifier -->
	<key>com.apple.developer.parent-application-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)app.takaoka.com.EventSnap2</string>
	</array>

	<!--
	  Vercel上のEventSnap WebサイトをApp Clip / Universal Linkの入口として使用。
	  Services/AppLinkConfig.swift の host と同じドメイン。
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>appclips:eventsnap-website.vercel.app</string>
		<string>applinks:eventsnap-website.vercel.app</string>
	</array>

	<!--
	  閲覧専用リニューアルに伴い追加。CloudKitのPublic Databaseを読み取り専用で
	  使うために必要（EventPreviewLoader.swift参照。書き込みは一切行わない）。
	  コンテナ識別子はメインアプリ（EventSnap2ターゲット）のEventSnap.entitlements
	  と同一にすること。

	  ⚠️ 注意: このファイルを編集しただけではXcodeに反映されないことがある。
	  実際にビルドする前に、Xcode上で
	  EventSnapClipターゲット → Signing & Capabilities → 「+ Capability」から
	  「iCloud」を追加し、「CloudKit」にチェック、コンテナに
	  `iCloud.app.takaoka.com.EventSnap2`（メインアプリと同じもの）を
	  選択/追加できているか、必ず手動で確認すること。
	-->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.takaoka.com.EventSnap2</string>
	</array>
</dict>
</plist>